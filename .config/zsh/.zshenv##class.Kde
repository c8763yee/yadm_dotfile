#!/usr/bin/env zsh

custom_dir="${ZDOTDIR:-$HOME/.config/zsh}/conf.d"
for file in "$custom_dir"/**/*.zsh(N); do
  [[ $file == */autocompletion/* ]] && (( ! $+functions[compdef] )) && continue
  # conf.d files are configuration fragments. Their final command status is
  # not an error contract (for example, an optional conditional may be false).
  [[ -r "$file" ]] && source "$file"
done
unset custom_dir file

if [[ -r "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env" || return 1
fi

return 0
